<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Standard Console Appender (human-readable) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%cyan(%d{yyyy-MM-dd HH:mm:ss}) %highlight(%-5level) %yellow(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Active for all profiles except prod (default, dev, test, etc.) -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.chatops" level="DEBUG"/>
        <logger name="org.springframework.web.socket" level="DEBUG"/>
        <logger name="org.springframework.boot" level="INFO"/>
        <logger name="com.zaxxer.hikari" level="INFO"/>
    </springProfile>

    <!-- Production logs (human-readable with full stack traces for container environments) -->
    <springProfile name="prod">
        <appender name="PROD_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n%ex</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="PROD_CONSOLE"/>
        </root>
        <logger name="com.chatops" level="INFO"/>
        <logger name="org.springframework.boot" level="INFO"/>
        <logger name="org.flywaydb" level="INFO"/>
        <logger name="com.zaxxer.hikari" level="INFO"/>
    </springProfile>

</configuration>
