# ============================================================
# ChatOps — Local Development Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatops
DB_USER=chatops
DB_PASSWORD=chatops_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# --- JWT ---
# IMPORTANT: Replace with a strong random 64+ char secret in production
JWT_SECRET=change-me-to-a-very-long-random-secret-string-at-least-64-characters-long
JWT_ACCESS_EXPIRY=3600000
JWT_REFRESH_EXPIRY=604800000

# --- App ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
